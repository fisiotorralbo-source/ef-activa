        function switchTab(tab) {
            const sections = ['objetivos', 'competencias-clave', 'competencias', 'criterios', 'objetivos-didacticos', 'tareas', 'evaluacion', 'saberes'];
            sections.forEach(s => {
                const el = document.getElementById('section-' + s);
                if(el) el.classList.add('hidden');
                const btn = document.getElementById('btn-tab-' + s);
                if(btn) btn.className = "pb-3 px-4 font-bold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition flex items-center gap-2 whitespace-nowrap";
            });

            const targetSec = document.getElementById('section-' + tab);
            if(targetSec) targetSec.classList.remove('hidden');
            const targetBtn = document.getElementById('btn-tab-' + tab);
            if(targetBtn) targetBtn.className = "pb-3 px-4 font-bold text-sm border-b-2 border-blue-600 text-blue-600 transition flex items-center gap-2 whitespace-nowrap";
        }

        function loadData() {
            // Cargar Objetivos ESO
            const savedObj = localStorage.getItem('ef_cantabria_objetivos');
            renderObjetivosGrid(savedObj ? JSON.parse(savedObj) : DEFAULT_OBJETIVOS);

            // Cargar Competencias Clave
            const savedCompClave = localStorage.getItem('ef_cantabria_competencias_clave');
            renderCompetenciasClaveGrid(savedCompClave ? JSON.parse(savedCompClave) : DEFAULT_COMPETENCIAS_CLAVE);

            // Cargar Competencias Específicas
            const savedComp = localStorage.getItem('ef_cantabria_competencias');
            renderCompetenciasGrid(savedComp ? JSON.parse(savedComp) : DEFAULT_COMPETENCIAS);

            // Cargar Criterios
            const savedCrit = localStorage.getItem('ef_cantabria_criteria');
            document.getElementById('table-criteria-body').innerHTML = savedCrit || DEFAULT_CRITERIA;

            // Cargar Objetivos Didácticos
            const savedObjDidac = localStorage.getItem('ef_cantabria_objetivos_didacticos');
            renderObjetivosDidacticosTable(savedObjDidac ? JSON.parse(savedObjDidac) : DEFAULT_OBJETIVOS_DIDACTICOS);

            // Cargar Tareas
            const savedTareas = localStorage.getItem('ef_cantabria_tareas');
            renderTareasTable(savedTareas ? JSON.parse(savedTareas) : DEFAULT_TAREAS);

            // Cargar Procedimientos
            const savedProc = localStorage.getItem('ef_cantabria_procedimientos');
            renderProcedimientosTable(savedProc ? JSON.parse(savedProc) : DEFAULT_PROCEDIMIENTOS);

            // Cargar Instrumentos
            const savedInst = localStorage.getItem('ef_cantabria_instrumentos');
            renderInstrumentosTable(savedInst ? JSON.parse(savedInst) : DEFAULT_INSTRUMENTOS);

            // Cargar Título
            const savedTitle = localStorage.getItem('ef_cantabria_title');
            if(savedTitle) document.getElementById('navTitle').innerText = savedTitle;

            // Cargar Saberes
            const savedSaberes = localStorage.getItem('ef_cantabria_saberes');
            renderSaberesGrid(savedSaberes ? JSON.parse(savedSaberes) : DEFAULT_SABERES);
        }

        // Renderizado de Objetivos de la ESO
        function renderObjetivosGrid(data) {
            const grid = document.getElementById('objetivos-grid');
            grid.innerHTML = '';
            data.forEach((obj, index) => {
                const card = document.createElement('div');
                card.className = "bg-slate-50 p-4 rounded-xl border border-slate-200 flex items-start gap-3 group";
                card.innerHTML = `
                    <div class="bg-blue-600 text-white font-bold text-xs px-2.5 py-1 rounded-md flex-shrink-0 mt-0.5">
                        <span contenteditable="true">${obj.id}</span>
                    </div>
                    <div class="flex-grow">
                        <p contenteditable="true" class="text-sm text-slate-700 leading-relaxed focus:bg-white focus:p-2 focus:rounded">${obj.text}</p>
                    </div>
                    <div class="no-print flex items-center gap-1 opacity-0 group-hover:opacity-100 transition">
                        <button onclick="deleteObjetivoCard(${index})" class="bg-rose-100 hover:bg-rose-200 text-rose-700 text-xs px-2 py-1 rounded font-medium transition" title="Eliminar objetivo"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function getObjetivosFromDOM() {
