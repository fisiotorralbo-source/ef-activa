                    <td class="p-3 align-top text-slate-600" contenteditable="true">${item.ejemplo}</td>
                    <td class="text-center no-print p-3 align-top">
                        <button onclick="deleteRow(this)" class="text-rose-600 hover:text-rose-800 p-1" title="Eliminar fila"><i class="fa-solid fa-trash-can"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function getObjetivosDidacticosFromDOM() {
            const rows = document.querySelectorAll('#table-objetivos-didacticos-body tr');
            const data = [];
            rows.forEach(row => {
                const tds = row.querySelectorAll('td');
                if(tds.length >= 3) {
                    data.push({
                        criterio: tds[0].innerText.trim(),
                        significa: tds[1].innerText.trim(),
                        ejemplo: tds[2].innerText.trim()
                    });
                }
            });
            return data;
        }

        function addObjetivoDidacticoRow() {
            const data = getObjetivosDidacticosFromDOM();
            data.push({
                criterio: "X.X",
                significa: "Redacta qué significa el objetivo didáctico...",
                ejemplo: "Describe un ejemplo práctico para el aula..."
            });
            renderObjetivosDidacticosTable(data);
        }

        // Renderizado de Tareas y Evidencias
        function renderTareasTable(data) {
            const tbody = document.getElementById('table-tareas-body');
            tbody.innerHTML = '';
            data.forEach((item) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 align-top font-bold text-blue-600" contenteditable="true">${item.codigo}</td>
                    <td class="p-3 align-top text-slate-700" contenteditable="true">${item.tarea}</td>
                    <td class="p-3 align-top text-slate-600 font-medium" contenteditable="true">${item.evidencia}</td>
                    <td class="text-center no-print p-3 align-top">
                        <button onclick="deleteRow(this)" class="text-rose-600 hover:text-rose-800 p-1" title="Eliminar fila"><i class="fa-solid fa-trash-can"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function getTareasFromDOM() {
            const rows = document.querySelectorAll('#table-tareas-body tr');
            const data = [];
            rows.forEach(row => {
                const tds = row.querySelectorAll('td');
                if(tds.length >= 3) {
                    data.push({
                        codigo: tds[0].innerText.trim(),
                        tarea: tds[1].innerText.trim(),
                        evidencia: tds[2].innerText.trim()
                    });
                }
            });
            return data;
        }

        function addTareaRow() {
            const data = getTareasFromDOM();
            data.push({
                codigo: "X.X",
                tarea: "Describe la situación o tarea en el pabellón...",
                evidencia: "Describe la evidencia observable..."
            });
            renderTareasTable(data);
        }

        // Renderizado de Procedimientos de Evaluación
        function renderProcedimientosTable(data) {
            const tbody = document.getElementById('table-procedimientos-body');
            tbody.innerHTML = '';
            data.forEach((item) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 align-top font-bold text-blue-600" contenteditable="true">${item.procedimiento}</td>
                    <td class="p-3 align-top" contenteditable="true">${item.aplicacion}</td>
                    <td class="p-3 align-top text-slate-600 font-medium" contenteditable="true">${item.criterios}</td>
                    <td class="text-center no-print p-3 align-top">
                        <button onclick="deleteRow(this)" class="text-rose-600 hover:text-rose-800 p-1" title="Eliminar fila"><i class="fa-solid fa-trash-can"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function getProcedimientosFromDOM() {
            const rows = document.querySelectorAll('#table-procedimientos-body tr');
            const data = [];
            rows.forEach(row => {
                const tds = row.querySelectorAll('td');
                if(tds.length >= 3) {
                    data.push({
                        procedimiento: tds[0].innerText.trim(),
                        aplicacion: tds[1].innerText.trim(),
                        criterios: tds[2].innerText.trim()
                    });
                }
            });
            return data;
        }

        function addProcedimientoRow() {
            const data = getProcedimientosFromDOM();
            data.push({
                procedimiento: "Nuevo procedimiento...",
                aplicacion: "Descripción de la aplicación...",
                criterios: "X.X, X.X"
            });
            renderProcedimientosTable(data);
        }

        // Renderizado de Instrumentos de Evaluación
        function renderInstrumentosTable(data) {
            const tbody = document.getElementById('table-instrumentos-body');
            tbody.innerHTML = '';
            data.forEach((item) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 align-top font-bold text-blue-600" contenteditable="true">${item.instrumento}</td>
                    <td class="p-3 align-top text-slate-700" contenteditable="true">${item.uso}</td>
                    <td class="text-center no-print p-3 align-top">
                        <button onclick="deleteRow(this)" class="text-rose-600 hover:text-rose-800 p-1" title="Eliminar fila"><i class="fa-solid fa-trash-can"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function getInstrumentosFromDOM() {
            const rows = document.querySelectorAll('#table-instrumentos-body tr');
            const data = [];
            rows.forEach(row => {
                const tds = row.querySelectorAll('td');
                if(tds.length >= 2) {
                    data.push({
                        instrumento: tds[0].innerText.trim(),
                        uso: tds[1].innerText.trim()
                    });
                }
            });
            return data;
        }

        function addInstrumentoRow() {
            const data = getInstrumentosFromDOM();
            data.push({
                instrumento: "Nuevo instrumento...",
                uso: "Uso previsto de la herramienta..."
            });
            renderInstrumentosTable(data);
        }

        // Renderizado de Saberes Básicos (Tarjetas)
        function renderSaberesGrid(data) {
            const grid = document.getElementById('saberes-grid');
            grid.innerHTML = '';
            data.forEach((block, index) => {
                const card = document.createElement('div');
                card.className = "bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-3 relative group";
                
                let itemsHtml = block.items.map((item, i) => `
                    <li class="flex items-start justify-between gap-2 group/item">
                        <span contenteditable="true" class="flex-grow focus:bg-white focus:p-1 focus:rounded">${item}</span>
                        <button onclick="removeSaberItem(${index}, ${i})" class="text-slate-400 hover:text-rose-600 no-print opacity-0 group-hover/item:opacity-100 transition p-0.5" title="Eliminar ítem"><i class="fa-solid fa-xmark"></i></button>
                    </li>
                `).join('');

                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2 border-b border-slate-200 pb-2">
                        <h4 contenteditable="true" class="font-bold text-blue-600 text-base flex-grow">${block.title}</h4>
                        <div class="no-print flex items-center gap-1">
                            <button onclick="addSaberItem(${index})" class="bg-blue-100 hover:bg-blue-200 text-blue-700 text-xs px-2 py-1 rounded font-medium transition" title="Añadir punto"><i class="fa-solid fa-plus"></i></button>
                            <button onclick="deleteSabesCard(${index})" class="bg-rose-100 hover:bg-rose-200 text-rose-700 text-xs px-2 py-1 rounded font-medium transition" title="Eliminar bloque"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    </div>
                    <ul class="list-disc list-inside text-xs text-slate-700 space-y-1.5">
                        ${itemsHtml}
                    </ul>
                `;
                grid.appendChild(card);
            });
        }

        function getSaberesFromDOM() {
            const cards = document.querySelectorAll('#saberes-grid > div');
            const data = [];
            cards.forEach(card => {
                const items = [];
                card.querySelectorAll('ul li span').forEach(li => items.push(li.innerText));
                data.push({ title: card.querySelector('h4').innerText, items });
            });
            return data;
        }

        function addSaberItem(cardIndex) {
            const data = getSaberesFromDOM();
            data[cardIndex].items.push("Nuevo contenido de saber básico...");
            renderSaberesGrid(data);
        }

        function removeSaberItem(cardIndex, itemIndex) {
            const data = getSaberesFromDOM();
            data[cardIndex].items.splice(itemIndex, 1);
            renderSaberesGrid(data);
        }

        function deleteSabesCard(index) {
            if(confirm('¿Eliminar este bloque completo de saberes?')) {
                const data = getSaberesFromDOM();
                data.splice(index, 1);
                renderSaberesGrid(data);
            }
        }

        function addSabesCard() {
            const data = getSaberesFromDOM();
            data.push({ title: "NUEVO BLOQUE DE SABERES", items: ["Nuevo contenido asociado..."] });
            renderSaberesGrid(data);
        }

        function saveChanges() {
            localStorage.setItem('ef_cantabria_objetivos', JSON.stringify(getObjetivosFromDOM()));
            localStorage.setItem('ef_cantabria_competencias_clave', JSON.stringify(getCompetenciasClaveFromDOM()));
            localStorage.setItem('ef_cantabria_competencias', JSON.stringify(getCompetenciasFromDOM()));
            localStorage.setItem('ef_cantabria_criteria', document.getElementById('table-criteria-body').innerHTML);
            localStorage.setItem('ef_cantabria_objetivos_didacticos', JSON.stringify(getObjetivosDidacticosFromDOM()));
            localStorage.setItem('ef_cantabria_tareas', JSON.stringify(getTareasFromDOM()));
            localStorage.setItem('ef_cantabria_procedimientos', JSON.stringify(getProcedimientosFromDOM()));
            localStorage.setItem('ef_cantabria_instrumentos', JSON.stringify(getInstrumentosFromDOM()));
            localStorage.setItem('ef_cantabria_title', document.getElementById('navTitle').innerText);
            localStorage.setItem('ef_cantabria_saberes', JSON.stringify(getSaberesFromDOM()));

            showToast('¡Todos los cambios de las diferentes vistas se han guardado con éxito!');
        }

        function resetData() {
            if(confirm('¿Deseas restablecer los valores originales de todo el currículo? Se perderán las modificaciones manuales.')) {
                localStorage.removeItem('ef_cantabria_objetivos');
                localStorage.removeItem('ef_cantabria_competencias_clave');
                localStorage.removeItem('ef_cantabria_competencias');
                localStorage.removeItem('ef_cantabria_criteria');
                localStorage.removeItem('ef_cantabria_objetivos_didacticos');
                localStorage.removeItem('ef_cantabria_tareas');
                localStorage.removeItem('ef_cantabria_procedimientos');
                localStorage.removeItem('ef_cantabria_instrumentos');
                localStorage.removeItem('ef_cantabria_title');
                localStorage.removeItem('ef_cantabria_saberes');
                loadData();
                showToast('Plantilla restablecida a la normativa oficial');
            }
        }

        function addRow(tbodyId, type) {
            const tbody = document.getElementById(tbodyId);
            const tr = document.createElement('tr');
            
            if(type === 'block') {
                tr.className = "bg-slate-800 text-white font-bold";
                tr.innerHTML = `
                    <td colspan="3" contenteditable="true" class="p-3 uppercase tracking-wide">NUEVO BLOQUE DE CONTENIDOS</td>
                    <td class="text-center no-print p-3"><button onclick="deleteRow(this)" class="text-rose-300 hover:text-white p-1" title="Eliminar bloque"><i class="fa-solid fa-trash-can"></i></button></td>
                `;
            } else {
                tr.innerHTML = `
                    <td class="p-3 align-top font-bold text-blue-600" contenteditable="true">X.X</td>
                    <td class="p-3 align-top" contenteditable="true">Nuevo criterio de evaluación oficial...</td>
                    <td class="p-3 align-top" contenteditable="true">Saberes básicos asociados...</td>
                    <td class="text-center no-print p-3 align-top"><button onclick="deleteRow(this)" class="text-rose-600 hover:text-rose-800 p-1" title="Eliminar fila"><i class="fa-solid fa-trash-can"></i></button></td>
                `;
            }
            tbody.appendChild(tr);
        }

        function deleteRow(btn) {
            const row = btn.closest('tr');
            if(row && confirm('¿Deseas eliminar este elemento?')) {
                row.remove();
            }
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }
    </script>
</body>
</html>
